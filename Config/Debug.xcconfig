// Debug configuration for Barkain
// API base URL for local development.
//
// Left BLANK on purpose so AppConfig.swift's compile-time branching takes over:
//   - simulator → http://127.0.0.1:8000 (skips IPv6 happy-eyeballs)
//   - physical device → http://192.168.1.194:8000 (Mac LAN IP, en1)
// Both require uvicorn launched with --host 0.0.0.0. Override here per-machine
// if your LAN IP differs (e.g. `API_BASE_URL = http:$()/$()/192.168.X.Y:8000`).
API_BASE_URL =

// RevenueCat public API key (Step 2f — M11 Billing). Safe to commit — the
// public key is designed to ship in client bundles. The server-side webhook
// secret lives in backend/.env (REVENUECAT_WEBHOOK_SECRET), never here.
REVENUECAT_API_KEY = test_RtgnxKGXxhBYfljExWurnyPDYYh
