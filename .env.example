# Barkain — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
#
# CONVENTION (revised 2026-07-30):
#   * UNCOMMENTED  = a genuine override, or a secret you must supply.
#   * COMMENTED    = documented for discoverability, showing config.py's
#                    default. Uncomment only to override.
#
# The original rule was "only genuine overrides live here" — duplicating a
# default creates a drift trap (SP-5 post-mortem). That still holds for
# *live* values, which is why every default below stays commented out: an
# inert line cannot drift. But omitting a setting entirely proved worse.
# `DECODO_SCRAPER_API_AUTH` was undocumented for months, and an environment
# built from this file lost Amazon pricing with no error and no log line.
#
# INVARIANT: every setting in backend/app/config.py appears here, commented
# or not. `python3 scripts/check_env_example.py` enforces it.

# ── Auth (Clerk) ── required for all non-demo usage ─
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# ── UPC Resolution ── required for product scanning ─
GEMINI_API_KEY=xxxxx
# Optional: UPCitemdb paid tier key. Leave blank to use free trial (100/day).
UPCITEMDB_API_KEY=

# ── AI / Watchdog ── required for self-healing + recommendations ─
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Optional: Slack incoming webhook for Watchdog escalation notifications.
# Leave empty to only log escalations to stdout.
# WATCHDOG_SLACK_WEBHOOK=https://hooks.slack.com/services/xxxxx
# Known-good product the watchdog scrapes to prove a container still works.
# Change only if this SKU stops being universally stocked.
# WATCHDOG_TEST_QUERY=Sony WH-1000XM5

# ── Walmart Adapter Routing ──────────────────────────
# Which path handles walmart scrapes. Other retailers always use the
# container dispatch. Valid values:
#   decodo_http  — DEFAULT. Production path via Decodo residential proxy
#                  (set DECODO_PROXY_USER / DECODO_PROXY_PASS). ~2.8s per
#                  scrape, ~100% success at current pool health.
#   firecrawl    — legacy demo path via Firecrawl managed API. Firecrawl's
#                  upstream is currently 100% blocked by PerimeterX on
#                  Walmart — kept selectable for future recovery.
#   container    — legacy browser container, broken from any cloud IP.
# See docs/SCRAPING_AGENT_ARCHITECTURE.md Appendices A–C.
WALMART_ADAPTER=decodo_http

# ── Firecrawl (walmart demo path) ────────────────────
# Get your API key from https://firecrawl.dev/app/api-keys
# Only required when WALMART_ADAPTER=firecrawl.
FIRECRAWL_API_KEY=fc-xxxxx

# ── Decodo residential proxy (walmart production path) ─
# Sign up at https://decodo.com; credentials are in the dashboard under
# Residential Proxies → Authentication. Only required when
# WALMART_ADAPTER=decodo_http. The username will be automatically
# prefixed with `user-` and suffixed with `-country-us`.
DECODO_PROXY_USER=
DECODO_PROXY_PASS=
# Gateway host/port. Containers' proxy_relay.py reads HOST + PORT separately;
# walmart_http accepts either "host" or "host:port". Keep BOTH set in
# /etc/barkain-scrapers.env so the two consumers agree.
# DECODO_PROXY_HOST=gate.decodo.com
# DECODO_PROXY_PORT=7000

# ── Decodo Scraper API (amazon production path) ──────
# ⚠️  HIGH-CONSEQUENCE. This is NOT the same credential as the residential
# proxy above. When set, the amazon retailer leg routes through Decodo's
# maintained Amazon parser (~3 s, structured JSON) instead of the browser
# container (~50 s). When unset, Amazon falls back to the container path,
# which is broken from cloud IPs — so a fresh environment silently returns
# ZERO Amazon prices, with no error and no log line. Set this before you
# trust any price comparison.
# Literal Basic-auth header value from the Decodo dashboard, e.g.
# "Basic VTAwMDAz...". Include the "Basic " prefix.
DECODO_SCRAPER_API_AUTH=

# ── Container Dispatch ───────────────────────────────
# Override default 30s. Demo needs 180s for Best Buy warmup+scroll on
# EC2 t3.xlarge. Adjust down once warm-container pool is in place.
CONTAINER_TIMEOUT_SECONDS=180
# How container URLs are built. `{port}` is substituted per retailer.
# Point this at the scraper host when the API runs off-box.
# CONTAINER_URL_PATTERN=http://localhost:{port}
# Retries per container before the leg is marked failed.
# CONTAINER_RETRY_COUNT=1
# Retailer → port map. JSON object; pydantic parses it. Editing config.py is
# usually clearer — this exists for per-host remapping. 8086 (lowes) and
# 8089 (sams_club) were retired 2026-04-18 and must stay absent.
# CONTAINER_PORTS={"amazon":8081,"best_buy":8082,"walmart":8083,"target":8084,"home_depot":8085,"ebay_new":8087,"ebay_used":8088,"backmarket":8090,"fb_marketplace":8091}

# ── Database + Cache ─────────────────────────────────
# Defaults to local Docker (see docker-compose.yml). Uncomment and edit only
# when pointing to a different instance (staging RDS, a second local db, etc.).
# DATABASE_URL=postgresql+asyncpg://app:localdev@localhost:5432/barkain
# Test DB — the backend suite runs against Docker PG on 5433, NOT SQLite.
# TEST_DATABASE_URL=postgresql+asyncpg://app:test@localhost:5433/barkain_test
# REDIS_URL=redis://localhost:6379/0

# ── Runtime / Observability ──────────────────────────
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Surfaced on /health and in client headers. Bump at phase tags.
# APP_VERSION=0.2.0

# ── Rate Limiting ────────────────────────────────────
# Requests/min per user, by route class. Pro subscribers get their resolved
# limit multiplied by RATE_LIMIT_PRO_MULTIPLIER (tier cached 60s in Redis).
# RATE_LIMIT_GENERAL=60
# RATE_LIMIT_WRITE=30
# RATE_LIMIT_AI=10
# RATE_LIMIT_PRO_MULTIPLIER=2
# FB Marketplace location resolver. Hard cap, NO pro multiplier — this bucket
# protects a shared external budget (Decodo bytes + search tokens), not a
# user-tier feature. Singleflight only dedupes identical (country,state,city).
# RATE_LIMIT_FB_LOCATION_RESOLVE=5

# ── Billing / RevenueCat (Step 2f) ───────────────────
# Shared bearer token used to validate RevenueCat webhook requests against
# POST /api/v1/billing/webhook. Configure the same value in the RevenueCat
# dashboard under Project Settings → Integrations → Webhooks → Authorization.
# Required for the billing webhook to accept events (misconfig → 401).
REVENUECAT_WEBHOOK_SECRET=

# ── Affiliate Programs (Step 2g) ─────────────────────
# Amazon Associates store ID — live. Appended as ?tag=<id> to product URLs.
AMAZON_ASSOCIATE_TAG=barkain-20
# eBay Partner Network campaign ID — live. Used to build rover.ebay.com redirects.
EBAY_CAMPAIGN_ID=5339148665
# Walmart Impact Radius affiliate ID — placeholder, pending approval. Leave
# empty to pass Walmart product URLs through untagged.
# WALMART_AFFILIATE_ID=
# Shared bearer token for POST /api/v1/affiliate/conversion placeholder.
# Leave empty to accept any request (permissive placeholder mode).
AFFILIATE_WEBHOOK_SECRET=

# ── eBay Browse API + Marketplace Account Deletion webhook (Step 3b) ─
# Developer portal "Production Keyset". When both App ID + Cert ID are
# populated the ebay_new / ebay_used retailer legs route through the
# Browse API instead of the browser-container scrapers. App tokens
# auto-refresh (client_credentials grant, 2 hr TTL, cached in-process).
EBAY_APP_ID=
EBAY_CERT_ID=
# EXPERIMENT — Tier 2 search swap. SEARCH_TIER2_USE_EBAY swaps the second
# leg of the M1 Tier 2 cascade (parallel with Best Buy) from UPCitemdb to
# the eBay Browse API keyword search. USE_GTIN surfaces eBay's `gtin` as
# the row's primary_upc when present (rare on item_summary even with
# fieldgroups=EXTENDED, but harmless to leave on). SKIP_UPC forces eBay
# rows to omit primary_upc so iOS goes straight to /resolve-from-search.
# All three default off — flip to true to A/B without code changes.
SEARCH_TIER2_USE_EBAY=false
SEARCH_TIER2_EBAY_USE_GTIN=false
SEARCH_TIER2_EBAY_SKIP_UPC=false
# EXPERIMENT — drop "box only", "for parts", "charger only" style listings
# from the M2 ebay_browse_api price stream. Especially noisy on used
# categories (laptops, phones). Default off.
M2_EBAY_DROP_PARTIAL_LISTINGS=false
# GDPR — required for Browse API production access. The token is an
# opaque 32-80 char string you generate (`openssl rand -hex 32`) and
# paste into the eBay portal + here. Endpoint is the fully-qualified
# public HTTPS URL eBay calls. The two MUST match exactly in both
# places or the SHA-256 challenge hash won't line up.
EBAY_VERIFICATION_TOKEN=
EBAY_ACCOUNT_DELETION_ENDPOINT=

# ── Best Buy Products API (Step 3c-bestbuy) ──────────
# Developer portal key (developer.bestbuy.com → My Account → Keys).
# When set, the best_buy retailer leg routes through the Products API
# (~150 ms per call) instead of the browser-container scraper
# (~80–90 s). Missing key → container fallback, same pattern as eBay.
# Free tier: 5 calls/sec, 50k/day.
BESTBUY_API_KEY=

# ── Resolve + Search Behavior ────────────────────────
# Confidence gate on /resolve-from-search. Below this, the endpoint returns
# 409 RESOLUTION_NEEDS_CONFIRMATION and iOS renders a confirmation sheet
# instead of silently resolving a best guess. Dial down to 0.50 if testers
# hit the dialog too often.
# LOW_CONFIDENCE_THRESHOLD=0.70
#
# Last-resort thumbnail backfill for search rows no primary provider
# populated: eBay Browse (free) → Serper /images (~$0.001/call). Both passes
# soft-fail to the iOS placeholder. Default ON — pass 2 only fires for rows
# pass 1 missed, so the cost ceiling is bounded.
# SEARCH_THUMBNAIL_FALLBACK=true
#
# provisional-resolve: flips /resolve-from-search's "no UPC at all" branch
# from a hard 404 into a best-effort persisted Product (source='provisional',
# upc=NULL) so the user gets a price stream keyed on their search string.
# DARK-LAUNCHED — built and live-verified (Festool 577419 → real $700 FB
# Marketplace listing), never switched on. See docs/LOOSE_ENDS.md §P1.
# PROVISIONAL_RESOLVE_ENABLED=false

# ── M14 Misc-Retailer Slot (Step 3n) ─────────────────
# Surfaces up to 3 non-scraped retailers alongside the 9 first-class legs.
# Valid values:
#   disabled                  — DEFAULT. Service returns [], slot invisible.
#   serper_shopping           — primary; calls Serper /shopping (needs
#                               SERPER_API_KEY).
#   google_shopping_container — Z-standby stub (NotImplementedError).
#   decodo_serp_api / oxylabs_serp_api / brightdata_serp_api — X-fallback stubs.
# Built + iOS card shipped (#80, #81); the $50-Serper → bench → 5% → 50% →
# 100% canary was never started. See docs/LOOSE_ENDS.md §P1.
# MISC_RETAILER_ADAPTER=disabled

# ── Background Workers (Step 2h) ─────────────────────
# LocalStack SQS endpoint for local dev. Leave empty in production so
# boto3 resolves real AWS SQS via the default credential chain (IAM
# role, ~/.aws/credentials, etc.).
SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
# LocalStack accepts any AWS credentials; "test"/"test" is the convention.
# boto3 reads AWS_* directly from the environment, not from config.py.
# In prod, set these from IAM or leave empty to use the default chain.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Worker cadence — seeded with prod defaults; tune via env if needed.
PRICE_INGESTION_STALE_HOURS=6
DISCOUNT_VERIFICATION_STALE_DAYS=7
DISCOUNT_VERIFICATION_FAILURE_THRESHOLD=3

# ── Demo Mode ────────────────────────────────────────
# Uncomment to bypass Clerk auth for local testing. NEVER use in production.
# Renamed in Step 2i-b — was BARKAIN_DEMO_MODE; pydantic-settings now reads
# this directly into settings.DEMO_MODE.
# DEMO_MODE=1

# ── Portal Monetization (Step 3g) ────────────────────
# Feature flag — defaults off so demo / test / first-boot environments never
# leak referral attribution. Flip to true in prod once the referral URLs
# below are populated.
PORTAL_MONETIZATION_ENABLED=false

# Rakuten personal refer-a-friend URL. Populate immediately — Rakuten's
# personal referral program is open without partnership approval. Empty →
# resolver returns GUIDED_ONLY mode for non-members (still a useful pill).
RAKUTEN_REFERRAL_URL=

# BeFrugal personal refer-a-friend URL. Same shape as Rakuten. Swap to a
# publisher referral URL if BeFrugal ever responds to the formal-partnership
# email.
BEFRUGAL_REFERRAL_URL=

# TopCashback via FlexOffers. Both blank until FlexOffers approval lands;
# resolver falls through to GUIDED_ONLY in the meantime.
TOPCASHBACK_FLEXOFFERS_PUB_ID=
TOPCASHBACK_FLEXOFFERS_LINK_TEMPLATE=

# Resend (transactional email — used by the portal worker to alert when
# a portal returns 0 rows for 3 consecutive runs). Empty key → log a
# WARNING and skip the send (worker still runs, no crash). Mirrors the
# AFFILIATE_WEBHOOK_SECRET permissive-placeholder convention from Step 2g.
RESEND_API_KEY=
RESEND_ALERT_FROM=
RESEND_ALERT_TO=

# ── UPC Vendor Comparison Bench (one-off — bench/vendor-compare-1) ─
# Serper SERP API key for the AI resolve leg's E-then-B path. When set,
# m1_product first attempts UPC resolution via Serper top-5 organic →
# Gemini synthesis (cheap, fast); falls back to grounded Gemini on null.
# When empty, the Serper path is soft-skipped and resolve runs grounded
# only (the pre-vendor-migrate-1 behavior). Get one at https://serper.dev
# (paid tier required for production volume; free tier 2,500 credits is
# enough only for the bench scripts in scripts/bench_*.py).
SERPER_API_KEY=
